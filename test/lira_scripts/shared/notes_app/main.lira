module notes_main

import NoteService from "./service"
import MemoryNoteStore from "./memory_store"

define export function main()
  define variable store = construct MemoryNoteStore()
  define variable service = construct NoteService(store)
  call print("notes: starting")
  define variable created = call service.create("hello")
  call print(created.title)
  define variable title = call service.firstTitle()
  call print(title)
